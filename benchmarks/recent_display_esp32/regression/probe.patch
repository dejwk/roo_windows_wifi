+void RunRegressionBenchmark() {
+  regression_probe = true;
+  CHECK_EQ(xtensa_perfmon_init(0, XTPERF_CNT_INSN, XTPERF_MASK_INSN_ALL, 0, 0),
+           ESP_OK);
+  CHECK_EQ(
+      xtensa_perfmon_init(1, XTPERF_CNT_I_STALL, XTPERF_MASK_I_STALL_ALL, 0, 0),
+      ESP_OK);
+  for (int round = 0; round < 8; ++round) {
+    regression_mask_checks = (round % 2 == 0);
+    const uint16_t masks[] = {0x1ff, 0x3f, 0x40, 0x180};
+    CHECK_EQ(xtensa_perfmon_init(1, XTPERF_CNT_I_STALL, masks[round / 2], 0, 0),
+             ESP_OK);
+    Serial.printf("GATE,%d,%d,%u\n", round, regression_mask_checks,
+                  masks[round / 2]);
+    RunScene(false, "rounded", 4, 160, 120);
+  }
+  Serial.println("END,regression");
+}
